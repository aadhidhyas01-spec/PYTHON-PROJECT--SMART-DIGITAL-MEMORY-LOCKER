# Copy to .env and fill in your own private values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash

# Optional. Leave blank to use local SQLite only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-supabase-secret-key
USE_SUPABASE=false
